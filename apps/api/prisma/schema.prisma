generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalMode {
  AUTO
  REVIEW
}

enum JobStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  displayName        String?
  passwordHash       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  channels           Channel[]
  jobs               OptimizationJob[]
  billingProfile     BillingProfile?
}

model Channel {
  id                     String              @id @default(cuid())
  userId                 String
  youtubeChannelId       String
  title                  String?
  approvalMode           ApprovalMode        @default(REVIEW)
  scheduleEnabled        Boolean             @default(true)
  scheduleHourLocal      Int                 @default(9)
  scheduleMinuteLocal    Int                 @default(0)
  timezone               String              @default("UTC")
  maxRunsPerDay          Int                 @default(5)
  maxRunsPerMonth        Int                 @default(150)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthCredential        OAuthCredential?
  jobs                   OptimizationJob[]
  auditLogs              AuditLog[]
  usageRecords           UsageRecord[]

  @@unique([userId, youtubeChannelId])
}

model OAuthCredential {
  id                     String   @id @default(cuid())
  channelId              String   @unique
  provider               String
  encryptedAccessToken   String
  encryptedRefreshToken  String?
  expiresAt              DateTime?
  scope                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  channel                Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model OptimizationJob {
  id                     String    @id @default(cuid())
  userId                 String
  channelId              String
  status                 JobStatus @default(QUEUED)
  triggerSource          String
  targetVideoId          String?
  notes                  String?
  originalTitle          String?
  originalDescription    String?
  originalTags           Json?
  generatedTitle         String?
  generatedDescription   String?
  generatedTags          Json?
  generatedTopicSummary  String?
  generatedThumbnailUrl  String?
  failureReason          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  completedAt            DateTime?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel                Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  auditLogs              AuditLog[]
}

model AuditLog {
  id               String   @id @default(cuid())
  channelId        String
  jobId            String?
  action           String
  oldPayload       Json?
  newPayload       Json?
  createdAt        DateTime @default(now())
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  job              OptimizationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model UsageRecord {
  id               String   @id @default(cuid())
  channelId        String
  periodDay        String
  periodMonth      String
  runCount         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, periodDay])
}

model BillingProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  planCode         String   @default("free")
  status           String   @default("active")
  monthlyRunCap    Int      @default(150)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
