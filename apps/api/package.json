{
  "name": "@yt-agent/api",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm run build -w @yt-agent/shared",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "echo 'No lint configured for api'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/sensible": "^6.0.2",
    "@yt-agent/shared": "0.1.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0",
    "openai": "^4.76.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2",
    "@types/luxon": "^3.4.2"
  }
}