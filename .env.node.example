# Shared
NODE_ENV=development
DATABASE_URL=postgresql://yt_agent:yt_agent@localhost:5432/yt_agent
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# API
API_PORT=4000
WEB_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
JWT_SECRET=replace_with_long_random_secret
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback

# Worker
WORKER_CONCURRENCY=2

# Storage (S3 or MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=yt-agent-assets
S3_FORCE_PATH_STYLE=true

# Product controls
DEFAULT_DAILY_LIMIT=5
DEFAULT_MONTHLY_LIMIT=150
